# Copy this file to .env only if you want to override the local server.
# The application does not read this file by itself. Set the variables in the
# shell before starting server.py. Do not put real secrets in either file.

# Interface the local server binds to. Keep this on localhost for a demo.
BONA_HOST=127.0.0.1

# Port for the local server.
BONA_PORT=8765

# Optional origin used in sitemap.xml and robots.txt. No trailing slash.
# Leave unset to use the Host header of the request.
# BONA_PUBLIC_ORIGIN=http://127.0.0.1:8765
